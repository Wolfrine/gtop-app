{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {"application": "gt-papers", "cachePolicy": "public-shell-only"},
  "assetGroups": [
    {
      "name": "gt-papers-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {"files": ["/index.html", "/*.css", "/*.js", "/manifest.webmanifest", "/desk-fold.webp", "/assistant-config.json", "/icons/papers-*.webp", "/icons/papers-fold-16.png", "/icons/papers-fold-32.png", "/icons/papers-fold-180.png", "/icons/papers-fold-192.png", "/icons/papers-fold-512.png", "/media/*.woff2", "/fonts/*.woff2"]}
    }
  ],
  "dataGroups": [],
  "navigationUrls": ["/**", "!/**/*.*", "!/api/**", "!/__/**", "!/__/auth/**"],
  "navigationRequestStrategy": "freshness"
}
