{
    "hosting": {
        "headers": [
            {
                "source": "/**",
                "headers": [
                    {
                        "key": "Access-Control-Allow-Origin",
                        "value": "*"
                    },
                    {
                        "key": "Access-Control-Allow-Credentials",
                        "value": "true"
                    },
                    {
                        "key": "Set-Cookie",
                        "value": "SameSite=None; Secure"
                    }
                ]
            }
        ],
        "public": "dist/gtop-app/browser",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    }
}