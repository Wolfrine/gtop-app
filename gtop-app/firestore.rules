rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function roleUnchanged() {
      // Legacy profiles may omit role, but cannot use that omission to promote themselves.
      return request.resource.data.get('role', 'user') == resource.data.get('role', 'user');
    }

    function createsSelfUser(uid) {
      return isSelf(uid)
        && (!('role' in request.resource.data) || request.resource.data.role == 'user');
    }

    function ownsResult() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function createsOwnResult() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function sessionHost(sessionId) {
      return signedIn()
        && exists(/databases/$(database)/documents/LiveSessions/$(sessionId))
        && get(/databases/$(database)/documents/LiveSessions/$(sessionId)).data.hostId == request.auth.uid;
    }

    function sessionExists(sessionId) {
      return exists(/databases/$(database)/documents/LiveSessions/$(sessionId));
    }

    function writesOwnParticipant(uid) {
      return isSelf(uid) && request.resource.data.get('uid', uid) == uid;
    }

    match /Meta/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if createsSelfUser(uid) || isAdmin();
      allow update: if isAdmin() || (isSelf(uid) && roleUnchanged());
      allow delete: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if signedIn();
      allow write: if isAdmin();
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flagCount', 'lastFlaggedAt'])
        && request.resource.data.flagCount == resource.data.get('flagCount', 0) + 1
        && !exists(/databases/$(database)/documents/questionFlags/$(questionId + '_' + request.auth.uid))
        && existsAfter(/databases/$(database)/documents/questionFlags/$(questionId + '_' + request.auth.uid))
        && getAfter(/databases/$(database)/documents/questionFlags/$(questionId + '_' + request.auth.uid)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/questionFlags/$(questionId + '_' + request.auth.uid)).data.questionId == questionId;
    }

    match /deletedQuestions/{questionId} {
      allow read, write: if isAdmin();
    }

    match /syllabus/{syllabusId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /syllabus-preview/{previewId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Drafts remain private; published snapshots cannot be overwritten or deleted.
    match /curriculumSubjects/{scopeId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.id == scopeId
        && request.resource.data.revision is int
        && request.resource.data.academicYear is string;
    }
    match /curriculumVersions/{versionId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.reviewStatus == 'approved'
        && request.resource.data.completeness == 'complete'
        && request.resource.data.sourceStatus == 'official-source'
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.approvedAt == request.time
        && request.resource.data.versionId == versionId
        && request.resource.data.sources is list && request.resource.data.sources.size() > 0
        && request.resource.data.chapters is list && request.resource.data.chapters.size() > 0
        && request.resource.data.chapters.size() <= 400;
    }
    match /curriculumReleases/{scopeId} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.id == scopeId
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.approvedAt == request.time
        && getAfter(/databases/$(database)/documents/curriculumVersions/$(request.resource.data.versionId)).data.id == scopeId
        && getAfter(/databases/$(database)/documents/curriculumVersions/$(request.resource.data.versionId)).data.academicYear == request.resource.data.academicYear
        && getAfter(/databases/$(database)/documents/curriculumVersions/$(request.resource.data.versionId)).data.reviewStatus == 'approved';
    }
    match /paperRequests/{requestId} {
      allow read, create, update: if isAdmin();
    }
    match /curriculumImports/{requestId} {
      allow read, create, update: if isAdmin();
    }

    match /QuizResults/{resultId} {
      allow get, list: if ownsResult() || isAdmin();
      allow create: if createsOwnResult() || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /questionFlags/{flagId} {
      allow read: if isAdmin();
      // A transaction must be able to read its own missing flag before creating it.
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/questionFlags/$(flagId))
        || resource.data.userId == request.auth.uid);
      // Deterministic IDs prevent duplicate reports or impersonating another reporter.
      // Legacy clients may create the report alone; the counter requires an atomic write.
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.questionId is string
        && flagId == request.resource.data.questionId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/questions/$(request.resource.data.questionId)));
      allow update, delete: if isAdmin();
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.questionId == resource.data.questionId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reason', 'status', 'updatedAt'])
        && request.resource.data.status == 'open';
    }

    match /activity/{activityId} {
      allow read, write: if isAdmin();
    }

    match /appFeedback/{feedbackId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    match /automationRuns/{runId} {
      allow read: if isAdmin();
      allow write: if false;

      match /events/{eventId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /automationTasks/{taskId} {
      allow read: if isAdmin();
      allow write: if false;

      match /events/{eventId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /automationTaskEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /automationCoverage/{coverageId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /featureSignals/{signalId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /databankIssues/{issueId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /LiveSessions/{sessionId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.hostId == request.auth.uid;
      allow update: if isAdmin() || (signedIn()
        && resource.data.hostId == request.auth.uid
        && request.resource.data.hostId == resource.data.hostId);
      allow delete: if isAdmin() || (signedIn() && resource.data.hostId == request.auth.uid);

      match /participants/{participantId} {
        allow read: if signedIn();
        allow create, update: if isAdmin() || sessionHost(sessionId)
          || (sessionExists(sessionId) && writesOwnParticipant(participantId));
        allow delete: if isSelf(participantId) || isAdmin() || sessionHost(sessionId);
      }

      match /answers/{answerId}/items/{participantId} {
        allow read: if signedIn();
        allow create, update: if isAdmin() || sessionHost(sessionId)
          || (sessionExists(sessionId) && writesOwnParticipant(participantId));
        allow delete: if isAdmin() || sessionHost(sessionId);
      }
    }

    // Question paper and review work stays restricted to existing GT admins.
    match /actionPlans/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
      match /updates/{updateId} {
        allow read, create: if isAdmin();
        allow update, delete: if false;
      }
    }
    match /paperModule/{id} { allow read, write: if isAdmin(); }
    match /paperTemplates/{id} { allow read, write: if isAdmin(); }
    match /paperBlueprints/{id} { allow read, write: if isAdmin(); }
    match /paperDrafts/{id} { allow read, write: if isAdmin(); }
    match /questionTypeTaxonomy/{id} { allow read, write: if isAdmin(); }
    match /questionBankPriorities/{id} { allow read, write: if isAdmin(); }
    match /questionBankPriorityItems/{id} { allow read, write: if isAdmin(); }
    match /questionBankAgentInstructions/{id} { allow read, write: if isAdmin(); }
    match /devQuestions/{id} { allow read, write: if isAdmin(); }
    match /dev-questions/{id} { allow read, write: if isAdmin(); }
    match /Agents/{id} { allow read, write: if isAdmin(); }

    match /mcpAutomationLocks/{lockId} {
      allow read, write: if false;
    }

    match /mcpAuditLog/{auditId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
