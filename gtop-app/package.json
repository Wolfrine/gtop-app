{
  "name": "gtop-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node ./scripts/gen-syllabus-index.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "dev": "vite --config scripts/plant-preview.vite.mjs",
    "test:module": "vitest run --exclude \"src/**/*.rules.test.ts\"",
    "test:rules": "npx firebase-tools@15 emulators:exec --only firestore --project demo-gtop \"vitest run src/app/features/question-bank/core/firestore.rules.test.ts src/app/features/question-bank/core/paper-access.rules.test.ts src/app/features/question-bank/core/quiz-report.rules.test.ts && node scripts/learning-lab.rules.test.cjs && node scripts/plant-lab.rules.test.cjs\"",
    "e2e": "npx firebase-tools@15 emulators:exec --only auth,firestore,database --project gtop-app \"playwright test\"",
    "test:database-rules": "npx firebase-tools@15 emulators:exec --only database --project demo-gtop \"vitest run src/app/features/question-bank/core/database.rules.test.ts\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/cdk": "^17.3.10",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/fire": "^17.1.0",
    "@angular/forms": "^17.3.0",
    "@angular/material": "^17.3.10",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@angular/service-worker": "^17.3.0",
    "chart.js": "^4.4.8",
    "firebase": "^11.4.0",
    "ng2-charts": "^4.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.7",
    "@angular/cli": "^17.3.7",
    "@angular/compiler-cli": "^17.3.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.4.2",
    "vitest": "^4.1.10",
    "jsdom": "^26.1.0",
    "@playwright/test": "^1.54.0",
    "@firebase/rules-unit-testing": "^4.0.1"
  }
}
