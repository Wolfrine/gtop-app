{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": { "files": ["/index.html", "/manifest.webmanifest", "/robots.txt", "/*.css", "/*.js"] }
    },
    {
      "name": "brand-assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": { "files": ["/icons/**", "/*.(png|svg|ico|woff2)"] }
    }
  ]
}
