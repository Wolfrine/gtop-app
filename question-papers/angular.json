{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "question-papers": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/question-papers",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.json",
            "assets": [{"glob":"**/*","input":"public","output":"/"}],
            "styles": ["node_modules/katex/dist/katex.min.css", "src/styles.css"]
          },
          "configurations": {
            "production": {
              "fileReplacements": [{"replace":"src/dev-transport.ts","with":"src/dev-transport.production.ts"}],
              "outputHashing": "all",
              "budgets": [{"type":"initial","maximumWarning":"900kb","maximumError":"1.2mb"}]
            },
            "development": {"optimization":false,"extractLicenses":false,"sourceMap":true}
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {"buildTarget":"question-papers:build:production"},
            "development": {"buildTarget":"question-papers:build:development"}
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {"analytics":false}
}
