{
  "hosting": {
    "site": "gtop-question-papers",
    "public": "question-papers/dist/question-papers/browser",
    "ignore": ["firebase.assistant.json", "**/.*", "**/node_modules/**"],
    "headers": [{"source":"**","headers":[{"key":"Cache-Control","value":"no-store"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"same-origin"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"}]}],
    "rewrites": [{"source":"/api/**","function":{"functionId":"gtopAssistantGateway","region":"us-central1"}},{"source":"**","destination":"/index.html"}]
  },
  "functions": [{"source":"assistant-service","codebase":"gtop-assistant","runtime":"nodejs22","ignore":["node_modules","test","*-debug.log"]}],
  "firestore": {"rules":"gtop-app/firestore.rules"},
  "database": {"rules":"assistant-service/security/worker-database.rules.json"},
  "emulators": {"auth":{"port":9299},"firestore":{"port":8280},"database":{"port":9380},"functions":{"port":5201},"eventarc":{"port":9300},"ui":{"enabled":false},"singleProjectMode":true}
}
